<mujoco model="so101_gripper">
    <asset>
        <!-- mesh path resolved relative to this file's directory by robosuite -->
        <mesh name="moving_jaw_so101_v1" file="../robots/SOARM101/SO101/assets/moving_jaw_so101_v1.stl"/>
        <mesh name="wrist_camera_mount" file="meshes/so101/wrist_camera_2.stl" scale="0.001 0.001 0.001"/>
        <material name="moving_jaw_so101_v1_material" rgba="1 0.82 0.12 1"/>
        <material name="wrist_camera_mount_white" rgba="1 1 1 1"/>
    </asset>
    <worldbody>
        <body name="gripper_base" pos="0 0 0">
            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1"/>
            <!-- Massless mounting frame. gripper_base is a robosuite-only attachment body with no
                 counterpart in the upstream SO-ARM100 model (TheRobotStudio/SO-ARM100,
                 Simulation/SO101/so101_new_calib.xml) or the URDF: upstream goes gripper(0.087 kg)
                 -> moving_jaw(0.012 kg) directly. The real gripper mass (6th servo + jaw) is already
                 carried by those two bodies. The previous mass="3e-1" diaginertia="1e-2" was a
                 placeholder that added a phantom +0.3 kg (+47.5% of the 0.632 kg arm) at the wrist,
                 inflating gravity/inertial ground truth. 1e-9 mirrors the URDF gripper_frame_link
                 dummy convention. See robosuite_private/JOURNAL.md and the upstream drift-guard test. -->
            <inertial pos="0 0 0" mass="1e-9" diaginertia="1e-9 1e-9 1e-9"/>
            <!-- Moving jaw — same offset it had relative to the wrist_roll body in the arm XML -->
            <body name="moving_jaw" pos="0.0202 0.0188 -0.0234" quat="0.707107 0.707107 -1.85362e-08 1.85362e-08">
                <joint axis="0 0 1" name="gripper" type="hinge"
                       range="-0.17453297762778586 1.7453291995659765"
                       damping="0.60" frictionloss="0.052" armature="0.028"/>
                <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012"
                          fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                <geom name="moving_jaw_vis" type="mesh" contype="0" conaffinity="0" group="1"
                      pos="-5.55112e-17 -5.55112e-17 0.0189"
                      quat="1 -0 3.00524e-16 -2.00834e-17"
                      mesh="moving_jaw_so101_v1" material="moving_jaw_so101_v1_material"/>

                <!-- Convex primitive chain fitted to STL cross-sections. A single mesh
                     collision becomes one convex hull and fills the jaw's concavities. -->

                <geom name="moving_jaw_tip_col_0" type="box" pos="-0.00890 -0.08000 0.01890" size="0.00310 0.00215 0.00390" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_tip_col_1" type="box" pos="-0.00827 -0.07601 0.01885" size="0.00373 0.00215 0.00510" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_tip_col_2" type="box" pos="-0.00698 -0.07200 0.01880" size="0.00502 0.00215 0.00575" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_tip_col_3" type="box" pos="-0.00546 -0.06812 0.01890" size="0.00454 0.00205 0.00630" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_tip_col_4" type="box" pos="-0.00420 -0.06385 0.01889" size="0.00580 0.00205 0.00682" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_tip_col_5" type="box" pos="-0.00324 -0.06000 0.01890" size="0.00676 0.00215 0.00714" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_2" type="box" pos="-0.00190 -0.05350 0.01890" size="0.00640 0.00550 0.00810" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_3" type="box" pos="-0.00110 -0.04250 0.01890" size="0.00720 0.00490 0.00890" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_4" type="box" pos="-0.00040 -0.02985 0.01890" size="0.00790 0.00535 0.01110" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_5" type="box" pos="-0.00065 -0.01875 0.01890" size="0.00935 0.00575 0.02230" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_6" type="box" pos="-0.00010 -0.00725 0.01890" size="0.00990 0.00575 0.02400" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
                <geom name="moving_jaw_col_7" type="box" pos="0.00000 0.00425 0.01890" size="0.01000 0.00575 0.02400" group="0" friction="0.4 0.02 0.001" solimp="0.995 0.999 0.001" solref="0.005 1" rgba="1 0 0 0.65"/>
            </body>
            <!-- EEF sites used by robosuite's gripper interface -->
            <body name="eef" pos="0 0 0" quat="0.707105 0 0 -0.707105">
                <site name="so101_grip_site"          pos="0 0 0"   size="0.01 0.01 0.01" rgba="1 0 0 0.5"  type="sphere"   group="1"/>
                <site name="so101_ee"                 pos="0 0 0"   size="0.01 0.01 0.01" rgba="1 0 0 0.5"  type="sphere"   group="1"/>
                <site name="so101_ee_x"               pos="0.1 0 0" size="0.005 .1"       quat="0.707105 0 0.707108 0"  rgba="1 0 0 0" type="cylinder" group="1"/>
                <site name="so101_ee_y"               pos="0 0.1 0" size="0.005 .1"       quat="0.707105 0.707108 0 0"  rgba="0 1 0 0" type="cylinder" group="1"/>
                <site name="so101_ee_z"               pos="0 0 0.1" size="0.005 .1"       quat="1 0 0 0"                rgba="0 0 1 0" type="cylinder" group="1"/>
                <site name="so101_grip_site_cylinder" pos="0 0 0"   size="0.005 10"       rgba="0 1 0 0.3" type="cylinder" group="1"/>
                <!-- Wrist camera mock-up: collision-enabled white bracket plus a small forward-facing camera.
                     Mounted to eef so it follows the gripper without coupling to the moving jaw. -->
                <!-- Camera assembly temporarily detached. Keep the full assembly here so it can
                     be restored without losing the calibrated mount and sensor transforms.
                <body name="gripper_camera_mount" pos="0.0590 0.0580 -0.0100" quat="0.7131418 0.0122326 0.7008025 -0.0124479">
                    <geom name="gripper_camera_mount_stl_vis" type="mesh" mesh="wrist_camera_mount"
                          pos="-0.0510 -0.0310 0.0060" quat="0.7071068 0.0000000 0.7071068 0.0000000" material="wrist_camera_mount_white"
                          contype="0" conaffinity="0" group="1"/>
                    <geom name="gripper_camera_mount_stl_col" type="mesh" mesh="wrist_camera_mount"
                          pos="-0.0510 -0.0310 0.0060" quat="0.7071068 0.0000000 0.7071068 0.0000000" group="0" friction="1 0.03 0.001"/>
                    <body name="gripper_camera_sensor" pos="-0.0370 -0.0560 -0.0130" quat="0.9935340 -0.0086704 0.1131989 0.0009879">
                        <geom name="gripper_camera_body" type="box" pos="0 0 0" size="0.001 0.016 0.016"
                              rgba="0.015 0.015 0.015 1" contype="0" conaffinity="0" group="1"/>
                        <geom name="gripper_camera_body_col" type="box" pos="0 0 0" size="0.001 0.016 0.016"
                              rgba="0.015 0.015 0.015 1" group="0" friction="1 0.03 0.001"/>
                        <geom name="gripper_camera_lens" type="cylinder" pos="0.009 0 0" size="0.006 0.008"
                              euler="0 1.57079632679 0" rgba="0.04 0.04 0.06 1" contype="0" conaffinity="0" group="1"/>
                        <geom name="gripper_camera_lens_col" type="cylinder" pos="0.009 0 0" size="0.006 0.008"
                              euler="0 1.57079632679 0" rgba="0.04 0.04 0.06 1" group="0" friction="1 0.03 0.001"/>
                        <camera name="gripper_cam" mode="fixed" pos="0.018 0 0"
                                xyaxes="0 -1 0 -0.22 0 0.975" fovy="86.63"/>
                    </body>
                </body>
                -->
            </body>
        </body>
    </worldbody>
    <actuator>
        <!-- position actuator: ctrl = target joint angle → GRIP controller maps [-1,1] proportionally
             to this ctrlrange, giving continuous jaw control instead of bang-bang torque. -->
        <!-- kp/kv/forcerange match the upstream sts3215 actuator class
             (TheRobotStudio/SO-ARM100 so101_new_calib.xml: kp=998.22 kv=2.731, and the
             real STS3215 stall torque is 3.35 N m; simulation contact is capped at 1.20 N m
             to avoid driving the rigid jaw deeply into grasped objects).
             kv was previously absent (undamped) and forcerange used the class default ±2.94. -->
        <position name="gripper" joint="gripper" kp="998.22" kv="2.731"
                  ctrllimited="true"  ctrlrange="-0.17453297762778586 1.7453291995659765"
                  forcelimited="true" forcerange="-1.20 1.20"/>
    </actuator>
    <sensor>
        <force  name="force_ee"  site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>
</mujoco>
